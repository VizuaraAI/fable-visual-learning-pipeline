# Copy to .env at the repo root (git ignores .env). Never paste these into chats, commits or screenshots.
ELEVENLABS_API_KEY=
# Optional: Blender executable if it is not at /Applications/Blender.app/Contents/MacOS/Blender
# VL_BLENDER=/usr/local/bin/blender
# Optional: which Modal workspace the cloud commands use when you have more than one profile
# MODAL_PROFILE=vizuaraai
